        "acentric_factor",
        "triple_point_temperature",
        "triple_point_pressure",
        "radius_of_gyration",
        "site_1_connectivity",
        "site_1_radii",
        "site_1_partial_charge",
        "site_1_epsilon",
        "site_1_sigma",
        "site_2_connectivity",
        "site_2_radii",
        "site_2_partial_charge",
        "site_2_epsilon",
        "site_2_sigma",
        "site_3_connectivity",
        "site_3_radii",
        "site_3_partial_charge",
        "site_3_epsilon",
        "site_3_sigma"
    ],
    "film_scaler": "maxabs",

    "model_size": "large",
    "standardize_target": false,
    "n_train_augments": 1,
    "enable_rotation_aug": true,

    "epochs": 100,
    "t_max_epochs": 75,
    "warmup_epochs": 5,
    "early_stopping_patience": 25
