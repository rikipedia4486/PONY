{
    "_comment": "hMOF isotherms with adsorbate/state FiLM conditioning (formerly model_training_script_pbc_film.py).",

    "h5_path": "/scratch/sk10275/PONY_ML/PONY_refactored_4/datasets/mofxdb_point_clouds.h5",
    "train_csv": "hmof_isotherm_train.csv",
    "val_csv": "hmof_isotherm_val.csv",
    "test_csv": "hmof_isotherm_test.csv",
    "output_dir": "/scratch/sk10275/PONY_ML/PONY_refactored_4/models_trained/hmof_isotherm_large_maxabs",

    "target": "Uptake(mol/kg)",
    "structure_id_col": "ID",
